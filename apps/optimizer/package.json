{
  "name": "@imgopt/optimizer",
  "version": "0.0.0",
  "private": true,
  "description": "SQS-triggered Lambda: intrinsic metadata, LQIP, conditional master, and the eager warm set.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "bundle": "node esbuild.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@imgopt/config": "workspace:*",
    "@imgopt/core": "workspace:*",
