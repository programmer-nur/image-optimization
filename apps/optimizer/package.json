    "@imgopt/metrics": "workspace:*",
    "@imgopt/queue": "workspace:*",
    "@imgopt/storage": "workspace:*",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "esbuild": "^0.24.0",
    "sharp": "^0.35.3",
    "vitest": "^2.1.8"
  }
}
