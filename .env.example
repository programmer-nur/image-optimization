# Copy to .env for local development. Values below match docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug

# --- Storage (MinIO locally, S3 in AWS) ---
AWS_REGION=us-east-1
S3_BUCKET=imgopt-dev
S3_ENDPOINT=http://localhost:9100
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Database ---
DATABASE_URL=postgres://imgopt:imgopt@localhost:5434/imgopt
DATABASE_MAX_CONNECTIONS=10

# --- Queue (ElasticMQ locally, SQS in AWS) ---
SQS_OPTIMIZE_QUEUE_URL=http://localhost:9324/000000000000/imgopt-optimize
SQS_ENDPOINT=http://localhost:9324

# --- Upload limits ---
UPLOAD_PROXY_THRESHOLD_BYTES=10485760
UPLOAD_MAX_FILE_BYTES=104857600
UPLOAD_MAX_PIXELS=100000000
UPLOAD_PRESIGN_TTL_SECONDS=300
UPLOAD_ACCEPTED_FORMATS=jpeg,png,webp,avif
UPLOAD_ALLOW_SVG=false
UPLOAD_FAIL_CLOSED_ON_SCAN_UNAVAILABLE=true

# --- Processing ---
MASTER_THRESHOLD_BYTES=20971520
MASTER_THRESHOLD_LONGEST_EDGE=4000
MASTER_LONGEST_EDGE=4000
WARM_WIDTHS=1080
WARM_FORMATS=avif
LQIP_WIDTH=24
GENERATION_TIMEOUT_MS=30000

# --- Delivery ---
CDN_HOST=localhost:3000
# Bump to re-encode every asset under new URLs without invalidating the CDN.
ENCODER_EPOCH=1
# CLOUDFRONT_DISTRIBUTION_ID=

# --- Security -----------------------------------------------------------------
# Whether a malware scanner is provisioned. Must match the infrastructure: the
# fail-closed policy below holds every upload when it claims a scanner that does
# not exist.
UPLOAD_MALWARE_SCAN_ENABLED=false
UPLOAD_FAIL_CLOSED_ON_SCAN_UNAVAILABLE=true

# Signed-URL delivery for private assets. All three together, or the feature is off.
# The private key comes from the secret store, never from a plain deployment value.
# SIGNED_URL_KEY_PAIR_ID=
# SIGNED_URL_PRIVATE_KEY=
# SIGNED_URL_TTL_SECONDS=300

# --- Lifecycle (scheduled maintenance) ----------------------------------------
# Safety margins, not tuning knobs. Shortening one makes reclamation race the system
# it cleans up after, and the objects at stake include originals.
ORPHAN_SAFETY_WINDOW_HOURS=24
SUPERSEDED_RETENTION_DAYS=30
PENDING_UPLOAD_TTL_HOURS=24
MAX_DELETIONS_PER_RUN=10000
# Counts what it would reclaim without reclaiming it. Worth a first run.
MAINTENANCE_DRY_RUN=false

# --- DNS and certificates (infra/cloudflare, never read by the app) -----------
# A scoped token with Zone:DNS:Edit on one zone. Never a global API key.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
