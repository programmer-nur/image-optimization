# The control plane's environment. Copy to /opt/imgopt/.env, mode 0600.
#
# Never committed: it holds the database password, the AWS access key the instance
# authenticates with, and the worker secret. `provision.sh` creates it empty.

# ---- deployment -------------------------------------------------------------
IMAGE_REPO=123456789012.dkr.ecr.us-east-1.amazonaws.com/imgopt-api
# Written by deploy.sh after a successful deploy. Leave blank on a fresh instance.
IMAGE_TAG=
API_HOST=api.example.com
NODE_ENV=production
LOG_LEVEL=info

# ---- AWS --------------------------------------------------------------------
AWS_REGION=us-east-1
# A Lightsail instance cannot assume an IAM role, so this is a long-lived access key
# for the `imgopt-<deployment>-control-plane` user the compute stack creates. It is
# the single strongest argument for the ECS migration, which deletes it. Rotate on the
# schedule in docs/operations.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET=imgopt-production-123456789012-us-east-1
SQS_OPTIMIZE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/imgopt-production-optimize

# ---- database ---------------------------------------------------------------
# One variable, and the only thing that changes when Postgres moves to RDS. The
# Lightsail managed database is private-only, so this host resolves nowhere else.
#
# `sslmode=require` is not optional: the connection crosses the Lightsail private
# network rather than a VPC subnet this deployment controls.
DATABASE_URL=postgresql://imgopt:PASSWORD@ls-xxxx.region.rds.amazonaws.com:5432/imgopt?sslmode=require
DATABASE_MAX_CONNECTIONS=10

# ---- workers ----------------------------------------------------------------
# Authenticates the optimizer and generator on /internal/v1. The same value is set on
# both Lambdas by the CDK, from `WORKER_CALLBACK_SECRET` at synth time — the two must
# match, and they rotate together by redeploying both sides.
#
#   openssl rand -hex 32
WORKER_CALLBACK_SECRET=

# ---- delivery ---------------------------------------------------------------
CDN_HOST=images.example.com
ENCODER_EPOCH=1
CLOUDFRONT_DISTRIBUTION_ID=

# ---- uploads ----------------------------------------------------------------
# Above the proxy threshold clients are handed a presigned S3 target and the bytes
# never transit this instance. That is the difference between a $5 host being viable
# and not, so raising it is a cost decision rather than a convenience one.
UPLOAD_PROXY_THRESHOLD_BYTES=10485760
UPLOAD_MAX_FILE_BYTES=104857600
UPLOAD_MALWARE_SCAN_ENABLED=false
UPLOAD_FAIL_CLOSED_ON_SCAN_UNAVAILABLE=false

# ---- reclamation ------------------------------------------------------------
# Read by the maintenance container, which runs from cron on this host.
MAINTENANCE_DRY_RUN=false
