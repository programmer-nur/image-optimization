// Asset registry.
//
// Every asset and every key belongs to a tenant, and a deployment always has at
// least one — a single-tenant installation is a deployment with one tenant row,
// not a deployment without the concept. The column is what makes a later collapse
// of several deployments into one a data migration rather than a route-by-route
// audit; see openspec/changes/multi-tenancy/design.md T2.
//
// Tenancy stops at the control plane. It appears in no URL, no object key, and no
// edge computation, because the delivery plane never reads this database (D1) and
// the URL space is free exactly once.
//
// Note what is NOT here: nothing on the delivery path reads this database. S3
// object existence is the sole authority for whether a derivative can be served,
// which is why images keep flowing when Postgres is down.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  moduleFormat = "esm"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for the CLI, and is supplied to PrismaClient via a driver adapter.
datasource db {
  provider = "postgresql"
}

/// An owning application. One row per deployment today; the column exists so that
/// several deployments can later share one installation without touching a URL.
model Tenant {
  id String @id

  /// Operator-facing name. Renameable at no cost precisely because it never
  /// appears in a URL or an object key.
  slug String @unique
  name String

  /// Quotas live here rather than on a key: an application that is issued a second
  /// key must not thereby receive a second allowance.
  maxBytes  BigInt? @map("max_bytes")
  maxAssets Int?    @map("max_assets")

  usedBytes  BigInt @default(0) @map("used_bytes")
  usedAssets Int    @default(0) @map("used_assets")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assets  Asset[]
  apiKeys ApiKey[]

  @@map("tenants")
}

enum AssetStatus {
  pending_upload
  stored
  ready
  rejected
  failed
  deleted
}

/// How a derivative came to exist, for cost attribution.
enum DerivativeOrigin {
  warm
  ondemand
}

model Asset {
  /// ULID: sortable, URL-safe, and independent of storage location or content.
  /// Globally unique, which is what lets two deployments merge later without a
  /// single key collision.
  id             String      @id
  /// Owning tenant. Every read and write is filtered on it.
  tenantId       String      @map("tenant_id")
  currentVersion Int         @default(0) @map("current_version")
  status         AssetStatus @default(pending_upload)

  altText    String?  @map("alt_text")
  tags       String[] @default([])
  /// Normalised focal point, {x, y} in 0..1.
  ///
  /// Advisory metadata for consumers that position images themselves. It does NOT
  /// drive delivery: the delivery plane never reads this database, so a stored point
  /// cannot reach the render — which is why `crop=focal` left the URL grammar.
  focalPoint Json?    @map("focal_point")

  /// Machine-readable reason for a terminal state. Null unless rejected/failed.
  failureReason String? @map("failure_reason")

  /// Owning API key, for quota accounting.
  apiKeyId String? @map("api_key_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  versions AssetVersion[]
  tenant   Tenant         @relation(fields: [tenantId], references: [id])

  /// Every index a scoped query uses leads with `tenantId`. One that does not turns
  /// a tenant-filtered lookup into a scan across every tenant's rows.
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, id])
  @@index([apiKeyId])
  @@map("assets")
}

model AssetVersion {
  assetId String @map("asset_id")
  version Int

  /// Immutable source key. Written exactly once, never read-modify-written.
  sourceKey String  @map("source_key")
  /// Bounded intermediate, only for very large sources. Never served to clients.
  masterKey String? @map("master_key")
  /// Size of that master. Recorded because the conditional-master threshold is a
  /// tuning decision, and a count of masters cannot show what widening it costs.
  masterBytes BigInt? @map("master_bytes")

  /// SHA-256 of the original bytes, for upload deduplication.
  ///
  /// Deduplication is scoped to the owning tenant, which the query reaches through
  /// `asset`. Matching across tenants would both hand one tenant a reference to
  /// another's asset and disclose that the other holds those exact bytes.
  contentHash String @map("content_hash")

  /// Displayed dimensions, with EXIF orientation already applied.
  width  Int?
  height Int?

  format        String?
  bytes         BigInt?
  hasAlpha      Boolean? @map("has_alpha")
  colorspace    String?
  orientation   Int?
  dominantColor String?  @map("dominant_color")

  /// Base64 WebP placeholder, inlined by the client SDK. Stored here rather than
  /// in S3 because a network round-trip would defeat a few-hundred-byte image.
  lqip String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// When this version stopped being current — stamped by the transaction that
  /// creates its successor. The retention window runs from here and never from
  /// `createdAt`: a source that was live for a year and was replaced yesterday is one
  /// day into its grace period, not a year past it. NULL means "still current, or the
  /// moment is unknown", and reclamation never deletes on an unknown.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)

  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  derivatives Derivative[]

  @@id([assetId, version])
  @@index([contentHash])
  @@index([supersededAt])
  @@map("asset_versions")
}

model Derivative {
  /// The canonical key: simultaneously the CDN cache key and the S3 object key.
  canonicalKey String @id @map("canonical_key")

  assetId String @map("asset_id")
  version Int

  format String
  width  Int?
  height Int?
  bytes  BigInt

  generatedAt DateTime         @default(now()) @map("generated_at") @db.Timestamptz(3)
  generatedBy DerivativeOrigin @map("generated_by")

  assetVersion AssetVersion @relation(fields: [assetId, version], references: [assetId, version], onDelete: Cascade)

  @@index([assetId, version])
  @@index([generatedAt])
  @@map("derivatives")
}

model ApiKey {
  id   String @id
  /// The tenant this key acts as. Immutable by policy: moving a key between
  /// tenants would silently change what it can already reach.
  tenantId String @map("tenant_id")
  name String

  /// SHA-256 of the whole key, unsalted — the secret half is 32 random bytes, so
  /// there is no dictionary for a salt to defeat. The plaintext is shown exactly
  /// once, at creation. See apps/api/src/modules/auth/api-key.ts.
  hash String @unique

  /// Coarse permissions, e.g. ["upload", "delete"].
  permissions String[] @default([])

  /// Per-key quotas, retained as a *secondary* ceiling for narrowing one key below
  /// its tenant's allowance. The tenant's limits are the accounting unit; these
  /// cannot raise them.
  maxBytes  BigInt? @map("max_bytes")
  maxAssets Int?    @map("max_assets")

  usedBytes  BigInt @default(0) @map("used_bytes")
  usedAssets Int    @default(0) @map("used_assets")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}
